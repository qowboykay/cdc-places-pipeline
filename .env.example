# Socrata Open Data API
# Get a free app token at https://data.cdc.gov/profile/app_tokens
SOCRATA_APP_TOKEN=

# AWS S3 (Phase 4+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

# Snowflake (Phase 4+)
# Account format: <org>-<account> (find in Snowflake UI under Admin -> Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=CDC_PLACES
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=DBT_ROLE

# Local DuckDB path (used in Phases 1-3)
DUCKDB_PATH=data/warehouse.duckdb
